# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string — Railway provides this automatically when you
# add a Postgres plugin to your project.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# ─── Clerk (Authentication) ───────────────────────────────────────────────────
# Found in your Clerk dashboard → API Keys.
# The publishable key is safe to expose in the frontend build.
VITE_CLERK_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The secret key is backend-only — never expose this in the frontend.
CLERK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: only needed if you are routing Clerk auth through a custom proxy.
# Leave blank if you are not using a Clerk proxy.
VITE_CLERK_PROXY_URL=

# ─── Cloudinary (Media Uploads) ───────────────────────────────────────────────
# Found in your Cloudinary dashboard → Settings → API Keys.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Admin Access ─────────────────────────────────────────────────────────────
# Comma-separated list of email addresses that are automatically granted
# admin privileges when they sign in.
ADMIN_EMAILS=admin@yourdomain.com

# ─── Server ───────────────────────────────────────────────────────────────────
# Railway sets PORT automatically — you do not need to set this manually.
PORT=3000

# Set to "production" when deploying.
NODE_ENV=production

# Optional: log verbosity. Options: trace, debug, info, warn, error. Default: info
LOG_LEVEL=info

# ─── Frontend Build ───────────────────────────────────────────────────────────
# The URL base path the frontend is served from.
# Use "/" if the app is served from the root of its own Railway service domain.
# Use "/homegrown-hoops" (or similar) only if serving under a subpath.
BASE_PATH=/
